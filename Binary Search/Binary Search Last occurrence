#include<iostream>
using namespace std;

int last_occurrence(int arr[], int size, int target)
{
    //Assuming the array is sorted in ascending order
    int left = 0;
    int right = size - 1;
    int result = -1;

    while (left <= right)
    {
        int mid = (left + right) / 2;

        if (arr[mid] == target)
        {
            result = mid; //In case, this is last occurence, we store it.
            left = mid + 1;//if this is not last occurence, it must be on the right side of mid, so we move left to mid + 1
        }
        else if (arr[mid] < target)
        {
            left = mid + 1;
        }
        else
        {
            right = mid - 1;
        }
    }

    return result; // Return the last occurrence index or -1 if not found
}
