int find_insert_position(int arr[], int size, int target)
{
    int left = 0;
    int right = size - 1;
    
    while(left <= right)
    {
        int mid =(left+right) / 2;
        
        if(arr[mid] < target)
        {
            left = mid + 1; // Move to the right half
        }
        else
        {
            right = mid - 1; // Move to the left half
        }
    }
    
    // 'left' naturally points to the correct insert position
    return left; 
}
