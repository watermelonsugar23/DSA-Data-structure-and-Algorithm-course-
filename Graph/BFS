#include <iostream>
#include <vector>
#include <queue>

using namespace std;

// Helper function to add an undirected edge
void addEdge(vector<vector<int>>& adj, int u, int v) {
    adj[u].push_back(v);
    adj[v].push_back(u);
}

// Function to perform Breadth First Search (BFS) starting from a given vertex
void bfs(const vector<vector<int>>& adj, int start) {
    int V = adj.size();

    // Check for valid start vertex
    if (start < 0 || start >= V) {
        cout << "Invalid start vertex!" << endl;
        return;
    }

    // Array to keep track of visited vertices
    vector<bool> visited(V, false);

    // Queue for BFS traversal
    queue<int> q;

    // Mark the start vertex as visited and enqueue it
    visited[start] = true;
    q.push(start);

    cout << "BFS Traversal starting from vertex " << start << ": ";

    while (!q.empty()) {
        // Dequeue a vertex from the front
        int current = q.front();
        q.pop();

        // Print the visited vertex
        cout << current << " ";

        // Get all adjacent neighbors of the current vertex
        for (int neighbor : adj[current]) {
            // If a neighbor has not been visited, mark it visited and enqueue it
            if (!visited[neighbor]) {
                visited[neighbor] = true;
                q.push(neighbor);
            }
        }
    }

    cout << endl;
}

int main() {
    int V = 6;
    vector<vector<int>> adj(V);

    // Build the graph with all 7 edges from the edge list
    addEdge(adj, 0, 1);
    addEdge(adj, 0, 3);
    addEdge(adj, 1, 2);
    addEdge(adj, 1, 4);
    addEdge(adj, 2, 5);
    addEdge(adj, 3, 4);
    addEdge(adj, 4, 5);

    // Perform BFS starting from vertex 0
    bfs(adj, 0);

    return 0;
}
