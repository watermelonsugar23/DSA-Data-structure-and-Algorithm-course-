#include<iostream>
using namespace std;

void selectionSort_asc(int arr[], int n)
{

    for(int blue = n-1; blue >= 1; blue--)
    {
        int maxIndex = 0;
        int maxValue = arr[0];
        for(int black = 0; black <= blue; black++)
        {
            if(arr[black] > maxValue)
            {
                maxValue = arr[black];
                maxIndex = black;
            }
        }
        swap(arr[maxIndex], arr[blue]);
    }

}

int main()
{
    int n;
    cin >> n;
    int arr[1000];
    for(int i = 0; i < n; i++)
    {
        cin >> arr[i];
    }
    selectionSort_asc(arr, n);

    for(int i = 0; i < n; i++)
    {
        cout << arr[i] << "  ";
    }

    cout << endl;

}
