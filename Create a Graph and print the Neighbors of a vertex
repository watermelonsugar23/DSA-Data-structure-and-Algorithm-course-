#include <iostream>
#include <vector>

using namespace std;

// Add an undirected edge between vertices u and v

void addEdge(vector<vector<int>>& adj, int u, int v) {
    adj[u].push_back(v);
    adj[v].push_back(u);
}

int main() {
    int V = 6; // Vertices 0 to 5
    vector<vector<int>> adj(V);

    // Adding all 7 edges from the edge list

    addEdge(adj, 0, 1);
    addEdge(adj, 0, 3);
    addEdge(adj, 1, 2);
    addEdge(adj, 1, 4);
    addEdge(adj, 2, 5);
    addEdge(adj, 3, 4);
    addEdge(adj, 4, 5);

    //Print the Adjacency List to verify

    cout << "Adjacency List:" << endl;
    for (int i = 0; i < V; ++i) {
        cout << i << ": ";
        for (int neighbor : adj[i]) {
            cout << neighbor << " ";
        }
        cout << endl;
    }

    return 0;
}
